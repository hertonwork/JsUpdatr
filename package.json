{
    "name": "@labs_kai/minim",
    "version": "3.0.1",
    "description": "Minim \u2014 the smallest HTML-first reactive library. 0.5 KB core, 1.2 KB with attribute bindings. No build, no dependencies, nothing eval'd.",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./iife": "./dist/minim.min.js",
        "./lite": "./lite/minim.min.js"
    },
    "files": [
        "dist",
        "lite/minim.js",
        "lite/minim.min.js",
        "lite/README.md",
        "lite/example.html",
        "src"
    ],
    "sideEffects": true,
    "scripts": {
        "build": "tsc && esbuild src/index.ts --bundle --minify --format=iife --global-name=minim --target=es2022 --outfile=dist/minim.min.js && npm run build:lite && npm run build:page && npm run build:skill",
        "build:lite": "esbuild lite/minim.js --minify --target=es2022 --outfile=lite/minim.min.js && node lite/build.mjs",
        "test": "npm run build && node --test test/index.test.mjs",
        "test:browser": "node test/dom.test.mjs",
        "test:lite": "node --test lite/core.test.mjs",
        "test:lite:browser": "node lite/dom.test.mjs",
        "size": "node lite/build.mjs --size",
        "build:page": "node docs/build-page.mjs",
        "chart": "node docs/size-chart.mjs",
        "build:skill": "node -e \"require('fs').copyFileSync('dist/minim.min.js','skills/minim-page/assets/minim.min.js');require('fs').copyFileSync('lite/minim.min.js','skills/minim-page/assets/minim-lite.min.js')\"",
        "check:page": "node skills/minim-page/scripts/check.mjs index.html"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hertonwork/minim"
    },
    "keywords": [
        "minim",
        "reactive",
        "reactivity",
        "signals",
        "data-binding",
        "html-first",
        "tiny",
        "no-build",
        "csp"
    ],
    "author": "Herton Fontineli <d@ntas.cc> (http://fontineli.com/)",
    "license": "MPL-2.0",
    "bugs": {
        "url": "https://github.com/hertonwork/minim/issues"
    },
    "homepage": "https://github.com/hertonwork/minim#readme",
    "engines": {
        "node": ">=20"
    },
    "devDependencies": {
        "esbuild": "^0.28.2",
        "typescript": "^7.0.2"
    },
    "publishConfig": {
        "access": "public"
    }
}
